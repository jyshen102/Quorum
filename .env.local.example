NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of email addresses allowed to sign in as admin.
# Anyone signing in with an email not on this list will be immediately
# signed out and bounced from the dashboard. REQUIRED — if unset, nobody
# can log in (fail closed).
ADMIN_EMAILS=you@example.com
